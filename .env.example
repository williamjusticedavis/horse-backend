# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
# Optional — defaults shown below
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allow requests from the frontend dev server (matches frontend-template default)
CORS_ORIGIN=http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace  (default: debug in dev, info in prod)
# LOG_LEVEL=debug

# ─── Cloudflare R2 (optional) ─────────────────────────────────────────────────
# Omit to fall back to local disk storage (./uploads/). All five vars must be
# present to activate R2. Set these in Render's environment dashboard for prod.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=   # e.g. https://pub-xxx.r2.dev
